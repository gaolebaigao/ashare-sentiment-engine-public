# Select the provider in config/default.yaml. BaoStock and the free providers
# remain available for local tests and development.
DATA_PROVIDER=tushare

# Required by the Tushare adapter. Never commit a real token.
TUSHARE_TOKEN=

# Optional; leave blank to use Tushare's default public endpoint.
TUSHARE_ENDPOINT=

# Optional: an explicit cache root. Defaults to ./data/cache.
ASHARE_CACHE_ROOT=data/cache
